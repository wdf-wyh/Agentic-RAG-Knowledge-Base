# ====================================================
# RAG 知识库 - 后端 Dockerfile
# 基于 Python 3.11 slim 镜像
# ====================================================

# ---------- 构建阶段：安装依赖 ----------
ARG PYTHON_IMAGE=python:3.11-slim
FROM ${PYTHON_IMAGE} AS builder

WORKDIR /app

# 安装系统构建依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 复制依赖文件并安装
COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install --prefix=/install --no-cache-dir -r requirements.txt

# ---------- 运行阶段 ----------
FROM ${PYTHON_IMAGE}

WORKDIR /app

# 安装运行时系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# 从构建阶段复制已安装的包
COPY --from=builder /install /usr/local

# 创建非 root 用户
RUN addgroup --system app && adduser --system --ingroup app appuser

# 复制项目代码
COPY . .

# 创建必要的目录
RUN mkdir -p logs vector_db documents uploads conversations memory output && \
    chown -R appuser:app /app

# 设置时区
ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# 设置环境变量默认值
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    API_HOST=0.0.0.0 \
    API_PORT=8000 \
    API_RELOAD=false \
    VECTOR_DB_PATH=/app/vector_db \
    LOG_LEVEL=INFO \
    HF_ENDPOINT=https://hf-mirror.com

# 预下载嵌入模型（使用镜像源）
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('BAAI/bge-small-zh-v1.5')" || echo "模型预下载失败，将在运行时重试"

# 暴露端口
EXPOSE 8000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

USER appuser

# 启动命令
CMD ["python", "run_api.py"]
